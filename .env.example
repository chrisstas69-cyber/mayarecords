# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings → API. The app runs in "seed content" mode without them
# (public site renders from built-in catalog data; admin requires them).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for the bulk importer commit step and admin user management.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — powers the store (merch + MP3/WAV downloads). Get keys at
# https://dashboard.stripe.com/apikeys. Checkout is disabled (with a clear
# message) until this is set.
STRIPE_SECRET_KEY=

# Absolute URL of the deployed site (SEO metadata / sitemap / Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Joeski Members — Stripe recurring price for the $10/mo tier (Products → add price → copy price_…)
STRIPE_MEMBERS_PRICE_ID=

# Signs the promoter press-kit access cookie. Any long random string: openssl rand -hex 32
EPK_SECRET=
